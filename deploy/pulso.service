# /etc/systemd/system/pulso.service  (en la VM cliente)
# Sustituye USUARIO_VM por tu usuario de Linux en la VM (salida de `whoami`).
[Unit]
Description=Pulso: API FastAPI y pantallas
After=network-online.target tailscaled.service docker.service
Wants=network-online.target

[Service]
User=USUARIO_VM
WorkingDirectory=/home/USUARIO_VM/Pulso/backend
EnvironmentFile=-/home/USUARIO_VM/Pulso/backend/.env
# 0.0.0.0 para que NGINX llegue por la VPN; UFW solo permite el 8000 desde tailscale0.
ExecStart=/home/USUARIO_VM/Pulso/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=100.64.0.2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
