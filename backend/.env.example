# Copia este archivo como backend/.env en la VM (el .env real NO se sube a git).
# Valores de ejemplo: cámbialos por los reales.
# En la VM: Ollama corre en el Windows anfitrión y se alcanza por el NAT de VirtualBox.
# Si Ollama está en la misma máquina que la app: http://localhost:11434
OLLAMA_URL=http://10.0.2.2:11434
OLLAMA_MODELO=granite4.2:3b
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=60m
# Opcional: ruta del build del frontend (por defecto ../dist)
# PULSO_DIST=/opt/pulso/dist
# Opcional: clave para ver /api/reportes (vacía = reportes abiertos; solo muestran datos anónimos y agregados)
REPORTES_CLAVE=
